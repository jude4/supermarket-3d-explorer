{
  "name": "supermarket-explorer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node ops/dev.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node tests/run.mjs",
    "test:browser": "node scripts/browser-test.mjs",
    "assets": "python3 scripts/generate-assets.py",
    "assets:retail": "python3 scripts/generate-retail.py",
    "test:retail": "node scripts/retail-browser-test.mjs",
    "dev:frontend": "vite --host 0.0.0.0",
    "setup": "node ops/setup.mjs",
    "api:dev": "npm --prefix server run dev",
    "start": "npm --prefix server start",
    "build:all": "npm run build && npm --prefix server run build",
    "db:start": "node ops/local-db.mjs",
    "db:migrate": "npm --prefix server run db:migrate",
    "db:seed": "npm --prefix server run db:seed",
    "staff:create": "npm --prefix server run staff:create",
    "test:api": "node ops/api-tests.mjs",
    "test:client": "node --import ./server/node_modules/tsx/dist/loader.mjs src/api/customer.test.mjs",
    "test:inventory": "node scripts/inventory-browser-test.mjs",
    "test:admin": "node scripts/admin-browser-test.mjs",
    "assets:premium": "blender --background --python scripts/model-premium-products.py",
    "test:visual": "node scripts/premium-browser-test.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.4.0",
    "@react-three/rapier": "^2.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.180.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "~5.9.3",
    "vite": "^7.1.9"
  }
}
